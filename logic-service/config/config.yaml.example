# FamilyOS Logic Service configuration example
# Copy this file to config.yaml and replace placeholders with local values.

server:
  grpc_port: 50051

database:
  dsn: "root:password@tcp(127.0.0.1:3306)/familyos_logic?charset=utf8mb4&parseTime=true&loc=Asia%2FShanghai"

jwt:
  # Must match the Gateway JWT secret.
  secret: "replace-with-a-long-random-secret"
  issuer: "familyos"
  audience: "familyos-mobile"
  access_ttl: "15m"
  refresh_ttl: "720h"

redis:
  addr: "127.0.0.1:6379"
  password: ""
  db: 0
  dial_timeout: "3s"
  read_timeout: "2s"
  write_timeout: "2s"
  key_prefix: "familyos:auth"

sms:
  provider: "console"
  # Inject a real value through FAMILYOS_SMS_CODE_HMAC_SECRET.
  code_hmac_secret: ""
  code_ttl: "5m"
  cooldown: "60s"
  daily_limit: 10
  ip_hourly_limit: 30
  ip_limit_window: "1h"

oss:
  endpoint: "oss-cn-beijing.aliyuncs.com"
  access_key_id: ""
  access_key_secret: ""
  bucket_name: ""
  document_prefix: "knowledge"
  download_ttl: "5m"

internal:
  # 通过 FAMILYOS_INTERNAL_AGENT_TOKEN 注入，Logic 与 Agent 必须一致。
  agent_token: ""

rocketmq:
  # RocketMQ 4.x NameServer 地址，例如 "localhost:9876"。
  endpoint: ""
  access_key: ""
  access_secret: ""
  poll_interval: "1s"
  lock_timeout: "1m"
  retry_base: "1s"
  retry_max: "5m"
