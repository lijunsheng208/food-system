# 本地服务配置可能包含数据库密码、Token 或第三方密钥。
gateway-service/config/config.yaml
logic-service/config/config.yaml
agent-service/config/config.yaml

# 本地环境变量文件；示例模板需要保留在仓库中。
.env
.env.*
!.env.example
!.env.*.example

# 日志和临时运行文件。
*.log
*.pid
*.tmp
tmp/

# Go 编译和测试产物。
bin/
dist/
coverage.out
*.test
*.prof

# Python 服务虚拟环境、缓存、测试产物和本地配置。
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
*.egg-info/
build/
agent-python-service/config/config.yaml
agent-python-service/.nltk_data/
agent-python-service/models/

# 本地 PDF/OCR 和模型运行缓存。
*.onnx
*.pt
*.pth
*.safetensors
*.pdf.tmp
pdf-output/
ocr-output/

# 本机编辑器工作区和调试会话文件。
*.code-workspace
:memory:.ses

# Node/Expo 依赖、缓存和构建产物。
node_modules/
.expo/
.expo-shared/
.metro-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE 与操作系统生成文件。
.DS_Store
.idea/
.vscode/
*.swp
*.swo
