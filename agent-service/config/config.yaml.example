database:
  dsn: "user:password@tcp(127.0.0.1:3306)/familyos_agent?charset=utf8mb4&parseTime=True&loc=Local"

rocketmq:
  # RocketMQ 4.x NameServer 地址，例如 "localhost:9876"。
  endpoint: ""
  access_key: ""
  access_secret: ""
  consumer_group: "familyos-agent-document-indexer"
  topic: "familyos-rag-document"
  receive_batch_size: 16
  invisible_duration: "30s"

logic:
  target: "127.0.0.1:50051"
  # 通过 FAMILYOS_AGENT_LOGIC_AGENT_TOKEN 注入，必须与 Logic 配置一致。
  agent_token: ""
  request_timeout: "10s"

worker:
  poll_interval: "1s"
  lock_timeout: "5m"
  retry_base: "5s"
  retry_max: "5m"
  max_attempts: 5

rag:
  enabled: false
  chunk_size: 500
  chunk_overlap: 50
  max_file_size: 20971520
  download_timeout: "30s"
  embedding:
    base_url: "https://api.openai.com/v1"
    # 通过 FAMILYOS_AGENT_RAG_EMBEDDING_API_KEY 注入。
    api_key: ""
    model: "text-embedding-3-small"
    dimensions: 1536
    batch_size: 16
    timeout: "30s"
  pgvector:
    # 通过 FAMILYOS_AGENT_RAG_PGVECTOR_DSN 注入。
    dsn: "host=127.0.0.1 user=postgres password=password dbname=familyos_agent_vector port=5432 sslmode=disable"
  opensearch:
    enabled: false
    endpoint: "http://127.0.0.1:9200"
    username: ""
    password: ""
    index: "familyos-chunks-active"
    request_timeout: "5s"
    dense_weight: 0.7
    lexical_weight: 0.3
    rrf_constant: 30
    candidate_k: 50

agent:
  enabled: false
  grpc_port: 50052
  rewrite:
    base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
    # 通过 FAMILYOS_AGENT_AGENT_REWRITE_API_KEY 注入。
    api_key: ""
    model: "qwen-turbo"
    timeout: "15s"
    max_tokens: 256
  chat:
    base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
    # 通过 FAMILYOS_AGENT_AGENT_CHAT_API_KEY 注入。
    api_key: ""
    model: "qwen-plus"
    timeout: "60s"
    max_tokens: 2048
  max_steps: 6
  top_k: 10
