database:
  dsn: "user:password@tcp(127.0.0.1:3306)/familyos_agent?charset=utf8mb4&parseTime=True&loc=Local"

logic:
  target: "127.0.0.1:50051"
  # 必须通过环境变量注入，并与 Logic 的 internal.agent_token 完全一致。
  agent_token: ""
  request_timeout: "10s"

ingress:
  port: 50053
  # 必须与 Go Adapter 使用的内部令牌一致。
  token: ""
  max_workers: 8

chat:
  port: 50054
  token: ""
  max_workers: 8
  base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  api_key: ""
  model: "qwen-plus"
  timeout: "60s"
  max_tokens: 2048
  max_steps: 8
  max_tool_calls: 6
  max_user_interrupts: 3
  # 留空时复用 database.dsn，并写入专用 agent_graph_checkpoint 表。
  checkpointer_dsn: ""
  metrics_port: 9108
  otel_endpoint: ""
  enable_query_rewrite: false
  rewrite_base_url: "https://api.openai.com/v1"
  rewrite_api_key: ""
  rewrite_model: ""
  rewrite_timeout: "15s"
  rewrite_max_tokens: 256

graph_extraction:
  enabled: false
  base_url: "https://api.openai.com/v1"
  api_key: ""
  model: ""
  timeout: "30s"
  max_tokens: 1200
  confidence_threshold: 0.7

graph_retrieval:
  enabled: false
  uri: "bolt://127.0.0.1:7687"
  user: "neo4j"
  password: ""
  database: "neo4j"
  timeout: "5s"

worker:
  poll_interval: "1s"
  lock_timeout: "5m"
  retry_base: "5s"
  retry_max: "5m"
  max_attempts: 5

rag:
  child_size: 500
  child_overlap: 50
  parent_size: 4000
  max_file_size: 20971520
  download_timeout: "30s"
  embedding:
    provider: "bge-m3"
    model_name: "./models/bge-m3"
    device: "cpu"
    use_fp16: false
    base_url: "https://api.openai.com/v1"
    # 必须通过环境变量注入真实密钥。
    api_key: ""
    model: "bge-m3"
    dimensions: 1024
    batch_size: 8
    timeout: "30s"
  milvus:
    uri: "http://127.0.0.1:19530"
    token: ""
    database: "default"
    collection: "familyos_document_chunks_v1"
    timeout: "10s"
    dense_index_type: "AUTOINDEX"
    dense_metric_type: "COSINE"
    rrf_k: 60
    candidate_limit: 50
  reranker:
    enabled: false
    # local 使用本地 BGE；dashscope 使用专用文本重排 API。
    provider: "local"
    base_url: "https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank"
    # dashscope API Key 必须通过 FAMILYOS_AGENT_RAG_RERANKER_API_KEY 注入。
    api_key: ""
    # 生产环境应挂载预下载模型，例如 BAAI/bge-reranker-v2-m3。
    model_name: "./models/bge-reranker-v2-m3"
    timeout: "30s"
    device: "cpu"
    use_fp16: false
    batch_size: 16
    max_length: 512
    # 首轮 RRF Child 召回数量，必须在 20～100 之间。
    recall_top_k: 50
  opensearch:
    enabled: false
    endpoint: "http://127.0.0.1:9200"
    username: ""
    password: ""
    index: "familyos-chunks-active"
    request_timeout: "5s"
