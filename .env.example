# Logic service secrets and Redis connection
FAMILYOS_DATABASE_DSN=root:password@tcp(127.0.0.1:3306)/familyos_logic?charset=utf8mb4&parseTime=true
FAMILYOS_JWT_SECRET=replace-with-a-long-random-secret
FAMILYOS_JWT_ISSUER=familyos
FAMILYOS_JWT_AUDIENCE=familyos-mobile
FAMILYOS_JWT_ACCESS_TTL=15m
FAMILYOS_JWT_REFRESH_TTL=720h
# Gateway 必须与 Logic Service 使用同一个 JWT 密钥。
FAMILYOS_GW_JWT_SECRET=replace-with-the-same-jwt-secret
FAMILYOS_GW_JWT_ISSUER=familyos
FAMILYOS_GW_JWT_AUDIENCE=familyos-mobile
FAMILYOS_SMS_CODE_HMAC_SECRET=replace-with-an-independent-long-random-secret
FAMILYOS_REDIS_ADDR=127.0.0.1:6379
FAMILYOS_REDIS_PASSWORD=
FAMILYOS_REDIS_DB=0
