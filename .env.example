# Logic service secrets and Redis connection
FAMILYOS_DATABASE_DSN=root:password@tcp(127.0.0.1:3306)/familyos_logic?charset=utf8mb4&parseTime=true
FAMILYOS_JWT_SECRET=replace-with-a-long-random-secret
FAMILYOS_JWT_ISSUER=familyos
FAMILYOS_JWT_AUDIENCE=familyos-mobile
FAMILYOS_JWT_ACCESS_TTL=15m
FAMILYOS_JWT_REFRESH_TTL=720h
# Gateway 必须与 Logic Service 使用同一个 JWT 密钥。
FAMILYOS_GW_JWT_SECRET=replace-with-the-same-jwt-secret
FAMILYOS_GW_JWT_ISSUER=familyos
FAMILYOS_GW_JWT_AUDIENCE=familyos-mobile
FAMILYOS_SMS_CODE_HMAC_SECRET=replace-with-an-independent-long-random-secret
FAMILYOS_REDIS_ADDR=127.0.0.1:6379
FAMILYOS_REDIS_PASSWORD=
FAMILYOS_REDIS_DB=0

# Logic 与 Agent 之间的内部接口令牌必须完全一致。
FAMILYOS_INTERNAL_AGENT_TOKEN=replace-with-an-independent-agent-token
FAMILYOS_AGENT_LOGIC_TARGET=127.0.0.1:50051
FAMILYOS_AGENT_LOGIC_AGENT_TOKEN=replace-with-the-same-agent-token

# RocketMQ 由 Go Adapter 消费，再通过内部 gRPC 转发给 Python。
FAMILYOS_ADAPTER_ROCKETMQ_ENDPOINT=127.0.0.1:8083
FAMILYOS_ADAPTER_CONSUMER_GROUP=familyos-agent-document-indexer
FAMILYOS_ADAPTER_TOPIC=familyos-rag-document
FAMILYOS_ADAPTER_PYTHON_TARGET=127.0.0.1:50053
FAMILYOS_ADAPTER_INTERNAL_TOKEN=replace-with-the-same-agent-token
FAMILYOS_AGENT_INGRESS_TOKEN=replace-with-the-same-agent-token

# Agent RAG 索引配置。
FAMILYOS_AGENT_RAG_ENABLED=true
FAMILYOS_AGENT_WORKER_MAX_ATTEMPTS=5
FAMILYOS_AGENT_RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
FAMILYOS_AGENT_RAG_EMBEDDING_API_KEY=replace-with-embedding-api-key
FAMILYOS_AGENT_RAG_EMBEDDING_MODEL=text-embedding-3-small
FAMILYOS_AGENT_RAG_EMBEDDING_DIMENSIONS=1536
FAMILYOS_AGENT_RAG_MILVUS_URI=http://127.0.0.1:19530
FAMILYOS_AGENT_RAG_MILVUS_TOKEN=
FAMILYOS_AGENT_RAG_MILVUS_DATABASE=default
FAMILYOS_AGENT_RAG_MILVUS_COLLECTION=familyos_document_chunks_v1
FAMILYOS_AGENT_RAG_MILVUS_DENSE_INDEX_TYPE=AUTOINDEX
FAMILYOS_AGENT_RAG_MILVUS_DENSE_METRIC_TYPE=COSINE
FAMILYOS_AGENT_RAG_OPENSEARCH_ENABLED=true
FAMILYOS_AGENT_RAG_OPENSEARCH_ENDPOINT=http://127.0.0.1:9200
FAMILYOS_AGENT_RAG_OPENSEARCH_INDEX=familyos-chunks-active

# Eino ReAct 问答配置；ChatModel 必须支持 OpenAI-compatible Tool Calling。
FAMILYOS_AGENT_AGENT_ENABLED=true
FAMILYOS_AGENT_AGENT_REWRITE_API_KEY=replace-with-rewrite-model-api-key
FAMILYOS_AGENT_AGENT_REWRITE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FAMILYOS_AGENT_AGENT_REWRITE_MODEL=qwen-turbo
FAMILYOS_AGENT_AGENT_CHAT_API_KEY=replace-with-chat-model-api-key
FAMILYOS_AGENT_AGENT_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FAMILYOS_AGENT_AGENT_CHAT_MODEL=qwen-plus
FAMILYOS_GW_AGENT_TARGET=127.0.0.1:50052

# 本地 Milvus 对象存储配置，仅用于开发环境。
FAMILYOS_MILVUS_MINIO_ACCESS_KEY=minioadmin
FAMILYOS_MILVUS_MINIO_SECRET_KEY=minioadmin
